# Antigravity Remote Studio Environment Variables (Optional overrides)

# 网页端访问密码 (留空则默认读取 config.json)
STUDIO_AUTH_TOKEN=antigravity

# 网络模式: lan (局域网) | cloud (云服务器中继) | tunnel (免配置穿透)
STUDIO_NETWORK_MODE=tunnel

# 云服务器 FRP 配置 (当 NETWORK_MODE 为 cloud 时使用)
VPS_HOST=your-vps-ip
VPS_SERVER_PORT=7000
VPS_REMOTE_PORT=8888
VPS_TOKEN=your_secure_token

# 消息推送配置 (可选)
# Bark (iOS 推送): https://github.com/Finb/Bark
BARK_KEY=
# PushPlus (微信推送): https://www.pushplus.plus/
PUSHPLUS_TOKEN=
# Server酱 (微信推送): https://sct.ftqq.com/
SERVERCHAN_SENDKEY=
